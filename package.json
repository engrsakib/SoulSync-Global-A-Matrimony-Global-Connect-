{
  "name": "soulsync-global",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --continue",
    "dev:restart": "node scripts/kill-dev-ports.mjs && turbo run dev --continue",
    "build": "turbo run build",
    "build:shared": "pnpm --filter @soulsync/shared-types build",
    "predev": "pnpm build:shared && pnpm db:generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,prisma}\"",
    "check:todos": "node scripts/check-todos.mjs",
    "db:generate": "pnpm --filter @soulsync/db db:generate",
    "db:migrate": "pnpm --filter @soulsync/db db:migrate",
    "db:deploy": "pnpm --filter @soulsync/db db:deploy",
    "db:seed": "pnpm --filter @soulsync/db db:seed",
    "db:studio": "pnpm --filter @soulsync/db db:studio",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "server:stop": "npx kill-port 3000 3001 4000"
  },
  "devDependencies": {
    "@soulsync/config": "workspace:*",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.9",
    "typescript": "6.0.3"
  }
}
