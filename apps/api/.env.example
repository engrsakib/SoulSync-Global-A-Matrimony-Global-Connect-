NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://soulsync:soulsync_dev@localhost:5432/soulsync?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://soulsync.local,http://admin.soulsync.local
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=7d
BCRYPT_ROUNDS=10
DEFAULT_AUTH_TENANT_SLUG=demo
LOGIN_CODE_PEPPER=change-me-login-code-pepper-min-16-chars

# SMTP (Gmail app password or provider credentials) — required to send email verification codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-address@gmail.com
APP_PUBLIC_NAME=SoulSync Global

# Cloudinary (server-side uploads only — rotate API secret if ever exposed)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional alternative (API also reads CLOUDINARY_URL=cloudinary://key:secret@cloud_name)
