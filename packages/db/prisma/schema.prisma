  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

enum UserNotificationType {
  COMMUNITY_MENTION
  BIODATA_EDITOR_INVITE
  BIODATA_EDITOR_REQUEST
  BIODATA_EDITOR_DECIDED
  MARRIAGE_CONFIRMATION_REQUEST
