enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  NEVER_MARRIED
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  ANNULLED
}

enum UserRole {
  MEMBER
  GUARDIAN
  MATCHMAKER
  TENANT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

