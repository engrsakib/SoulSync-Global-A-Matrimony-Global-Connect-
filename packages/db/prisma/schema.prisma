generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Religion {
  ISLAM
  HINDUISM
  CHRISTIANITY
  SIKHISM
  BUDDHISM
  JUDAISM
  JAINISM
  BAHAI
  OTHER
  PREFER_NOT_TO_SAY
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  NEVER_MARRIED
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  ANNULLED
}

enum UserRole {
  MEMBER
  GUARDIAN
  MATCHMAKER
  TENANT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum PhotoVisibility {
  PUBLIC
  MEMBERS_ONLY
  ON_CONSENT
  HIDDEN
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum ConsentType {
  DATA_PROCESSING
  PHOTO_REVEAL
  CONTACT_SHARE
  GUARDIAN_MANAGEMENT
}

enum CreditTransactionType {
  PURCHASE
  PROPOSAL_SENT
  REFUND
  BONUS
  ADJUSTMENT
}

enum BiodataSectionVisibilityMode {
  DIRECT
  REQUEST
}

enum BiodataAccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum BiodataDiscoveryReligionMode {
  SAME_AS_MINE
  ALL_RELIGIONS
  SELECTED_RELIGIONS
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum CommunityPostApprovalMode {
  AUTO_APPROVE
  ALL_PENDING
  TRUSTED_AUTO_REST_PENDING
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  PENDING
  ACTIVE
  BLOCKED
  REMOVED
  LEFT
}

enum CommunityPostStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum CommunityReactionKind {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PasswordChangeSource {
  INITIAL
  USER_CHANGE
  ADMIN_RESET
}

enum UserBadgeType {
  PROFILE_VERIFIED
  IDENTITY
  PHONE
  EMAIL
  COMMUNITY
}

enum TwoFactorMethod {
  TOTP
}

enum ComplexionPreference {
  FAIR
  VERY_FAIR
  WHEATISH
  DARK
  ANY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum EducationPreference {
  SECONDARY
  HSC
  GRADUATION
  POST_GRADUATION
  MADRASAH
  PROFESSIONAL
  ANY
}

enum OccupationPreference {
  SOFTWARE_ENGINEER
  BUSINESS
  GOVERNMENT_JOB
  DOCTOR
  TEACHER
  ENGINEER
  ACCOUNTANT
  OTHER
  ANY
}

enum ResidenceTypePreference {
  OWN_HOUSE
  RENTED
  FAMILY_OWNED
  ANY
}

enum FamilyStatusPreference {
  UPPER_CLASS
  HIGH_MIDDLE_CLASS
  MIDDLE_CLASS
  ANY
}

enum FamilyEconomicClass {
  UPPER_CLASS
  UPPER_MIDDLE_CLASS
  MIDDLE_CLASS
  LOWER_MIDDLE_CLASS
  LOWER_CLASS
}

enum PrayerRegularity {
  REGULAR_FIVE_TIMES
  NOT_REGULAR
}

enum SunnahBeardStatus {
  KEEPS_BEARD
  NOT_REGULAR_YET
}

enum QuranRecitationLevel {
  WITH_TAJWEED
  IMPROVING
  PARTIAL
  LEARNING
  NOT_YET
}

enum ClothingAboveAnkles {
  ALWAYS
  MOSTLY
  SOMETIMES
  NO
}

enum MahramCompliance {
  STRICT
  TRY_MY_BEST
  STILL_LEARNING
  NO
}

enum HijabPurdah {
  FULL_NIQAB
  BURQA_HIJAB
  MODEST_CLOTHING
  NOT_APPLICABLE
}

enum IslamMaslak {
  SARSINA
  DEOBANDI
  BARELVI
  TABLIGH
  AHLE_HADITH_SALAFI
  OTHER
  PREFER_NOT_TO_SAY
}

enum SiblingPositionPreference {
  ELDEST
  YOUNGEST
  MIDDLE
  ONLY_CHILD
  ANY
}

enum EmploymentTypePreference {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  STUDENT
  HOMEMAKER
  UNEMPLOYED
  ANY
}

model Tenant {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  supportedReligions Religion[]
  defaultLocale      String     @default("en")
  currency           String     @default("USD")
  settings           Json       @default("{}")
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users              User[]
  profiles           Profile[]
  creditWallets      CreditWallet[]
  proposals                  Proposal[]
  partnerPreferences         PartnerPreference[]
  myPreferences              MyPreference[]
  biodataSectionVisibilities BiodataSectionVisibility[]
  biodataAccessRequests      BiodataAccessRequest[]
  communities                Community[]

  @@map("tenants")
}

model User {
  id                   String     @id @default(cuid())
  tenantId             String
  email                String
  username             String?
  firstName            String?
  lastName             String?
  phone                String?
  /// True for login-code-only accounts until a real email is verified; then cleared in API.
  isGuest              Boolean    @default(false)
  loginCodeFingerprint String?    @unique
  loginCodeHash        String?
  loginCodeEnc         String?
  role                 UserRole   @default(MEMBER)
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?
  avatarUrl            String?
  avatarPublicId       String?
  lastLoginAt          DateTime?
  lastCheckInAt        DateTime?
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile           Profile?
  creditWallet      CreditWallet?
  credential        UserCredential?
  passwordHistory   PasswordHistory[]
  twoFactor         UserTwoFactor?
  badges            UserBadge[]        @relation("UserBadges")
  badgesGranted     UserBadge[]        @relation("BadgeVerifier")
  sentProposals                Proposal[]                   @relation("ProposalSender")
  receivedProposals            Proposal[]                   @relation("ProposalReceiver")
  consentLogs                  ConsentLog[]
  partnerPreference            PartnerPreference?
  myPreference                 MyPreference?
  biodataSectionVisibilities   BiodataSectionVisibility[]   @relation("BiodataVisibilityOwner")
  biodataAccessRequestsOwned   BiodataAccessRequest[]       @relation("BiodataAccessRequestOwner")
  biodataAccessRequestsSent    BiodataAccessRequest[]       @relation("BiodataAccessRequestRequester")
  communitiesCreated           Community[]                  @relation("CommunityCreatedBy")
  communityMemberships         CommunityMember[]
  communityJoinRequests        CommunityJoinRequest[]
  communityJoinRequestsDecided CommunityJoinRequest[]       @relation("CommunityJoinRequestDecider")
  communityPostsAuthored       CommunityPost[]              @relation("CommunityPostAuthor")
  communityPostsReviewed       CommunityPost[]              @relation("CommunityPostReviewer")
  communityPostsDeleted        CommunityPost[]              @relation("CommunityPostDeleter")
  communityPostsReferenced     CommunityPost[]              @relation("CommunityPostReferencedUser")
  communityCommentsAuthored    CommunityComment[]
  communityReactions           CommunityReaction[]
  communityMembersRemoved      CommunityMember[]            @relation("CommunityMemberRemover")

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@index([lastCheckInAt])
  @@map("users")
}

model UserCredential {
  userId            String   @id
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model PasswordHistory {
  id           String               @id @default(cuid())
  userId       String
  passwordHash String
  source       PasswordChangeSource @default(USER_CHANGE)
  createdAt    DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model UserTwoFactor {
  userId        String          @id
  isEnabled     Boolean         @default(false)
  method        TwoFactorMethod @default(TOTP)
  totpSecretEnc String?
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor")
}

model UserBadge {
  id           String        @id @default(cuid())
  userId       String
  badgeType    UserBadgeType
  isGranted    Boolean       @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User  @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("BadgeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([userId, badgeType])
  @@index([userId, isGranted])
  @@map("user_badges")
}

model Profile {
  id                                    String                @id @default(cuid())
  userId                                String                @unique
  tenantId                              String
  displayName                           String
  gender                                Gender
  dateOfBirth                           DateTime
  heightCm                              Int?
  weightKg                              Int?
  bloodGroup                            BloodGroup?
  hasChronicConditions                  Boolean?
  chronicConditionsDetail               String?
  maritalStatus                         MaritalStatus         @default(NEVER_MARRIED)
  country                               String
  stateRegion                           String?
  city                                  String
  postalCode                            String?
  locationDetails                       String?
  motherTongue                          String?
  education                             String?
  degreeName                            String?
  degreeMajor                           String?
  institution                           String?
  graduationYear                        Int?
  occupation                            String?
  employer                              String?
  yearsExperience                       Int?
  workLocation                          String?
  bio                                   String?
  religion                              Religion              @default(ISLAM)
  denomination                          String?
  community                             String?
  religiousPractice                     String?
  islamMaslak                           IslamMaslak?
  fatherIsAlive                         Boolean?
  motherIsAlive                         Boolean?
  fatherProfession                      String?
  motherProfession                      String?
  brotherCount                          Int?
  sisterCount                           Int?
  unclesOccupations                     String?
  residenceDescription                  String?
  familyEconomicClass                   FamilyEconomicClass?
  familyRelatives                       Json                  @default("[]")
  prayerRegularity                      PrayerRegularity?
  missedFardPrayersNotes                String?
  aqeedahNotes                          String?
  sunnahBeardStatus                     SunnahBeardStatus?
  beardDetails                          String?
  usualOutdoorClothing                  String?
  quranRecitationLevel                  QuranRecitationLevel?
  favoriteIslamicBooks                  String?
  favoriteScholars                      String?
  clothingAboveAnkles                   ClothingAboveAnkles?
  mahramCompliance                      MahramCompliance?
  entertainmentHabits                   String?
  dawahInvolvement                      String?
  quranHifzNotes                        String?
  incomeFullyHalal                      Boolean?
  hijabPurdah                           HijabPurdah?
  photoVisibility                       PhotoVisibility       @default(MEMBERS_ONLY)
  isDiscoverable                        Boolean               @default(true)
  isVisibilityPrivate                   Boolean               @default(false)
  checkInTimeZone                       String?
  showContactOnlyToAccepted             Boolean               @default(true)
  hideFromContacts                      Boolean               @default(false)
  guardianManaged                       Boolean               @default(false)
  discoveryReligionMode                 BiodataDiscoveryReligionMode @default(SAME_AS_MINE)
  discoveryReligionAllowList            Religion[]            @default([])
  guardianName                          String?
  guardianRelationship                  String?
  guardianMobile                        String?
  candidateMobile                       String?
  guardianTelegram                      String?
  guardianWhatsApp                      String?
  candidateTelegram                     String?
  candidateWhatsApp                     String?
  marriagePledgeInformationTrue         Boolean               @default(false)
  marriagePledgeGuardianConsent         Boolean               @default(false)
  marriagePledgeFalseInfoAccountability Boolean               @default(false)
  marriagePledgeMarkAfterMarriage       Boolean               @default(false)
  marriagePledgesAcceptedAt             DateTime?
  completenessScore                     Int                   @default(0)
  createdAt                             DateTime              @default(now())
  updatedAt                             DateTime              @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnerPreference PartnerPreference?
  myPreference      MyPreference?

  @@index([tenantId, religion, gender, isDiscoverable])
  @@index([isVisibilityPrivate, userId])
  @@map("profiles")
}

model PartnerPreference {
  id                        String                     @id @default(cuid())
  profileId                 String                     @unique
  userId                    String                     @unique
  tenantId                  String
  preferredGender           Gender
  minAge                    Int                        @default(21)
  maxAge                    Int                        @default(35)
  complexions               ComplexionPreference[]
  minHeightCm               Int?
  maxHeightCm               Int?
  educationLevels           EducationPreference[]
  occupations               OccupationPreference[]
  maritalStatuses           MaritalStatus[]
  minMonthlyIncome          Decimal?                   @db.Decimal(12, 2)
  maxMonthlyIncome          Decimal?                   @db.Decimal(12, 2)
  incomeCurrency            String                     @default("USD")
  residenceType             ResidenceTypePreference?
  familyStatus              FamilyStatusPreference?
  siblingCountPreference    Int?
  siblingPositionPreference SiblingPositionPreference?
  preferredDistricts        String[]
  preferredCountries        String[]
  preferredReligions        Religion[]
  preferredDenominations    String[]
  preferredCommunities      String[]
  preferredMotherTongues    String[]
  employmentTypes           EmploymentTypePreference[]
  willingToRelocate         Boolean                    @default(false)
  openToAbroad              Boolean                    @default(false)
  requiresVerifiedProfile   Boolean                    @default(false)
  minProfileCompleteness    Int                        @default(0)
  isActive                  Boolean                    @default(true)
  customExpectations        Json                       @default("{}")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, preferredGender, minAge, maxAge])
  @@map("partner_preferences")
}

/// Self-side enum-normalized facts for match scoring: compare A.partnerPreference to B.myPreference (and vice versa).
/// Age scoring uses Profile.dateOfBirth. Match percentage is computed in the API layer, not stored on this model.
model MyPreference {
  id                 String                     @id @default(cuid())
  profileId          String                     @unique
  userId             String                     @unique
  tenantId           String
  gender             Gender
  complexion         ComplexionPreference?
  heightCm           Int?
  educationLevel     EducationPreference?
  occupation         OccupationPreference?
  maritalStatus      MaritalStatus?
  monthlyIncome      Decimal?                   @db.Decimal(12, 2)
  incomeCurrency     String                     @default("USD")
  residenceType      ResidenceTypePreference?
  familyStatus       FamilyStatusPreference?
  siblingCount       Int?
  siblingPosition    SiblingPositionPreference?
  district           String?
  country            String?
  religion           Religion?
  denomination       String?
  community          String?
  motherTongue       String?
  employmentTypes    EmploymentTypePreference[]
  willingToRelocate  Boolean                    @default(false)
  openToAbroad       Boolean                    @default(false)
  customExpectations Json                       @default("{}")
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, gender, religion])
  @@map("my_preferences")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  tenantId  String
  balance   Int      @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([tenantId])
  @@map("credit_wallets")
}

model CreditTransaction {
  id        String                @id @default(cuid())
  walletId  String
  amount    Int
  type      CreditTransactionType
  reference String?
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("credit_transactions")
}

model Proposal {
  id               String         @id @default(cuid())
  tenantId         String
  senderId         String
  receiverId       String
  status           ProposalStatus @default(PENDING)
  message          String?
  creditsSpent     Int            @default(0)
  consentGrantedAt DateTime?
  respondedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender      User         @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("ProposalReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  consentLogs ConsentLog[]

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([tenantId, status])
  @@map("proposals")
}

model ConsentLog {
  id         String      @id @default(cuid())
  userId     String
  type       ConsentType
  granted    Boolean
  proposalId String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@map("consent_logs")
}

model BiodataSectionVisibility {
  id          String                       @id @default(cuid())
  tenantId    String
  ownerUserId String
  sectionId   String
  mode        BiodataSectionVisibilityMode @default(REQUEST)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("BiodataVisibilityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, sectionId])
  @@index([tenantId, ownerUserId])
  @@map("biodata_section_visibilities")
}

model BiodataAccessRequest {
  id              String                     @id @default(cuid())
  tenantId        String
  ownerUserId     String
  requesterUserId String
  sectionId       String
  status          BiodataAccessRequestStatus @default(PENDING)
  message         String?
  expiresAt       DateTime?
  decidedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User   @relation("BiodataAccessRequestOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  requester User   @relation("BiodataAccessRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, createdAt])
  @@index([requesterUserId, status])
  @@index([tenantId, status])
  @@map("biodata_access_requests")
}

model Community {
  id                 String                    @id @default(cuid())
  tenantId           String
  createdByUserId    String
  name               String
  slug               String
  description        String?
  coverImageUrl      String?
  coverImagePublicId String?
  allowedReligions   Religion[]                @default([])
  allowedCountries   String[]                  @default([])
  minAge             Int?
  maxAge             Int?
  privacy            CommunityPrivacy          @default(PUBLIC)
  postApprovalMode   CommunityPostApprovalMode @default(AUTO_APPROVE)
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("CommunityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members       CommunityMember[]
  joinRequests  CommunityJoinRequest[]
  posts         CommunityPost[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@map("communities")
}

model CommunityMember {
  id              String                @id @default(cuid())
  communityId     String
  userId          String
  tenantId        String
  role            CommunityMemberRole   @default(MEMBER)
  status          CommunityMemberStatus @default(ACTIVE)
  isTrustedPoster Boolean               @default(false)
  joinedAt        DateTime              @default(now())
  blockedAt       DateTime?
  removedAt       DateTime?
  removedByUserId String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  removedBy User?     @relation("CommunityMemberRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId, status, role])
  @@index([userId, status])
  @@map("community_members")
}

model CommunityJoinRequest {
  id              String                     @id @default(cuid())
  communityId     String
  userId          String
  tenantId        String
  message         String?
  status          CommunityJoinRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("CommunityJoinRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@index([userId, status])
  @@map("community_join_requests")
}

model CommunityPost {
  id                String              @id @default(cuid())
  communityId       String
  authorUserId      String
  tenantId          String
  bodyText          String?
  status            CommunityPostStatus @default(PENDING)
  publishedAt       DateTime?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectReason      String?
  referencedUserId  String?
  shareToken        String              @unique @default(cuid())
  deletedAt         DateTime?
  deletedByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  community       Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User                 @relation("CommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reviewer        User?                @relation("CommunityPostReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  referencedUser  User?                @relation("CommunityPostReferencedUser", fields: [referencedUserId], references: [id], onDelete: SetNull)
  deletedBy       User?                @relation("CommunityPostDeleter", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  images          CommunityPostImage[]
  comments        CommunityComment[]
  reactions       CommunityReaction[]  @relation("CommunityPostReactions")

  @@index([communityId, status, publishedAt])
  @@index([authorUserId, communityId])
  @@map("community_posts")
}

model CommunityPostImage {
  id        String  @id @default(cuid())
  postId    String
  sortOrder Int     @default(0)
  url       String
  publicId  String?
  width     Int?
  height    Int?

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("community_post_images")
}

model CommunityComment {
  id              String    @id @default(cuid())
  postId          String
  authorUserId    String
  parentCommentId String?
  bodyText        String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User                  @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parent    CommunityComment?     @relation("CommunityCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies   CommunityComment[]    @relation("CommunityCommentThread")
  reactions CommunityReaction[]   @relation("CommunityCommentReactions")

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunityReaction {
  id        String                @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  kind      CommunityReactionKind
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    CommunityPost?    @relation("CommunityPostReactions", fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityComment? @relation("CommunityCommentReactions", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("community_reactions")
}
