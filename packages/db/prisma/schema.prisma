enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PasswordChangeSource {
  INITIAL
  USER_CHANGE
  ADMIN_RESET
}

enum UserBadgeType {
  PROFILE_VERIFIED
  IDENTITY
  PHONE
  EMAIL
  COMMUNITY
}

enum TwoFactorMethod {
  TOTP
}

enum ComplexionPreference {
  FAIR
  VERY_FAIR
  WHEATISH
  DARK
  ANY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum EducationPreference {
  SECONDARY
  HSC
  GRADUATION
  POST_GRADUATION
  MADRASAH
  PROFESSIONAL
  ANY
}

enum OccupationPreference {
  SOFTWARE_ENGINEER
  BUSINESS
  GOVERNMENT_JOB
  DOCTOR
  TEACHER
  ENGINEER
  ACCOUNTANT
  OTHER
  ANY
}

enum ResidenceTypePreference {
  OWN_HOUSE
  RENTED
  FAMILY_OWNED
  ANY
}

enum FamilyStatusPreference {
  UPPER_CLASS
  HIGH_MIDDLE_CLASS
  MIDDLE_CLASS
  ANY
}

enum FamilyEconomicClass {
  UPPER_CLASS
  UPPER_MIDDLE_CLASS
  MIDDLE_CLASS
  LOWER_MIDDLE_CLASS
  LOWER_CLASS
}

enum PrayerRegularity {
  REGULAR_FIVE_TIMES
  NOT_REGULAR
}

enum SunnahBeardStatus {
  KEEPS_BEARD
  NOT_REGULAR_YET
}

enum QuranRecitationLevel {
  WITH_TAJWEED
  IMPROVING
  PARTIAL
  LEARNING
  NOT_YET
}

enum ClothingAboveAnkles {
  ALWAYS
  MOSTLY
  SOMETIMES
  NO
}

enum MahramCompliance {
  STRICT
  TRY_MY_BEST
  STILL_LEARNING
  NO
}

enum HijabPurdah {
  FULL_NIQAB
  BURQA_HIJAB
  MODEST_CLOTHING
  NOT_APPLICABLE
}

enum IslamMaslak {
  SARSINA
  DEOBANDI
  BARELVI
  TABLIGH
  AHLE_HADITH_SALAFI
  OTHER
  PREFER_NOT_TO_SAY
}

enum SiblingPositionPreference {
  ELDEST
  YOUNGEST
  MIDDLE
  ONLY_CHILD
  ANY
}

enum EmploymentTypePreference {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  STUDENT
  HOMEMAKER
  UNEMPLOYED
  ANY
}

model Tenant {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  supportedReligions Religion[]
  defaultLocale      String     @default("en")
  currency           String     @default("USD")
  settings           Json       @default("{}")
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users                      User[]
  profiles                   Profile[]
  creditWallets              CreditWallet[]
  proposals                  Proposal[]
  partnerPreferences         PartnerPreference[]
  myPreferences              MyPreference[]
  biodataSectionVisibilities BiodataSectionVisibility[]
  biodataAccessRequests      BiodataAccessRequest[]
  biodataEditorGrants        BiodataEditorGrant[]
  marriageConfirmations      MarriageConfirmation[]
  marriageRecords            MarriageRecord[]
  marriageRecordArchives     MarriageRecordArchive[]
  communities                Community[]

  @@map("tenants")
}

model User {
  id                   String     @id @default(cuid())
  tenantId             String
  email                String
  username             String?
  firstName            String?
  lastName             String?
  phone                String?
  /// True for login-code-only accounts until a real email is verified; then cleared in API.
  isGuest              Boolean    @default(false)
  loginCodeFingerprint String?    @unique
  loginCodeHash        String?
  loginCodeEnc         String?
  role                 UserRole   @default(MEMBER)
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?
  avatarUrl            String?
  avatarPublicId       String?
  lastLoginAt          DateTime?
  lastCheckInAt        DateTime?
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant                           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile                          Profile?
  creditWallet                     CreditWallet?
  credential                       UserCredential?
  passwordHistory                  PasswordHistory[]
  twoFactor                        UserTwoFactor?
  badges                           UserBadge[]                @relation("UserBadges")
  badgesGranted                    UserBadge[]                @relation("BadgeVerifier")
  sentProposals                    Proposal[]                 @relation("ProposalSender")
  receivedProposals                Proposal[]                 @relation("ProposalReceiver")
  consentLogs                      ConsentLog[]
  partnerPreference                PartnerPreference?
  myPreference                     MyPreference?
  biodataSectionVisibilities       BiodataSectionVisibility[] @relation("BiodataVisibilityOwner")
  biodataAccessRequestsOwned       BiodataAccessRequest[]     @relation("BiodataAccessRequestOwner")
  biodataAccessRequestsSent        BiodataAccessRequest[]     @relation("BiodataAccessRequestRequester")
  biodataEditorGrantsOwned         BiodataEditorGrant[]       @relation("BiodataEditorGrantOwner")
  biodataEditorGrantsAsEditor      BiodataEditorGrant[]       @relation("BiodataEditorGrantEditor")
  communitiesCreated               Community[]                @relation("CommunityCreatedBy")
  communityMemberships             CommunityMember[]
  communityJoinRequests            CommunityJoinRequest[]
  communityJoinRequestsDecided     CommunityJoinRequest[]     @relation("CommunityJoinRequestDecider")
  communityPostsAuthored           CommunityPost[]            @relation("CommunityPostAuthor")
  communityPostsReviewed           CommunityPost[]            @relation("CommunityPostReviewer")
  communityPostsDeleted            CommunityPost[]            @relation("CommunityPostDeleter")
  communityPostsReferenced         CommunityPost[]            @relation("CommunityPostReferencedUser")
  communityCommentsAuthored        CommunityComment[]
  communityReactions               CommunityReaction[]
  communityMembersRemoved          CommunityMember[]          @relation("CommunityMemberRemover")
  notifications                    UserNotification[]
  activityLogs                     UserActivityLog[]
  authSessions                     AuthSession[]
  marriageConfirmationsInitiated   MarriageConfirmation[]     @relation("MarriageInitiator")
  marriageConfirmationsAsPartner   MarriageConfirmation[]     @relation("MarriagePartner")
  marriageDivorceRequestsRequested MarriageConfirmation[]     @relation("MarriageDivorceRequestedBy")
  marriageRecords                  MarriageRecord[]
  marriageRecordArchives           MarriageRecordArchive[]
  subscriptionCheckoutIntents      SubscriptionCheckoutIntent[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@index([lastCheckInAt])
  @@map("users")
}

model UserCredential {
  userId            String   @id
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model PasswordHistory {
  id           String               @id @default(cuid())
  userId       String
  passwordHash String
  source       PasswordChangeSource @default(USER_CHANGE)
  createdAt    DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model UserTwoFactor {
  userId        String          @id
  isEnabled     Boolean         @default(false)
  method        TwoFactorMethod @default(TOTP)
  totpSecretEnc String?
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor")
}

model UserBadge {
  id           String        @id @default(cuid())
  userId       String
  badgeType    UserBadgeType
  isGranted    Boolean       @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User  @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("BadgeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([userId, badgeType])
  @@index([userId, isGranted])
  @@map("user_badges")
}

model Profile {
  id                                    String                       @id @default(cuid())
  userId                                String                       @unique
  tenantId                              String
  displayName                           String
  gender                                Gender
  dateOfBirth                           DateTime
  heightCm                              Int?
  weightKg                              Int?
  bloodGroup                            BloodGroup?
  hasChronicConditions                  Boolean?
  chronicConditionsDetail               String?
  maritalStatus                         MaritalStatus                @default(NEVER_MARRIED)
  country                               String
  stateRegion                           String?
  city                                  String
  postalCode                            String?
  locationDetails                       String?
  motherTongue                          String?
  education                             String?
  degreeName                            String?
  degreeMajor                           String?
  institution                           String?
  graduationYear                        Int?
  occupation                            String?
  employer                              String?
  yearsExperience                       Int?
  workLocation                          String?
  bio                                   String?
  religion                              Religion                     @default(ISLAM)
  denomination                          String?
  community                             String?
  religiousPractice                     String?
  islamMaslak                           IslamMaslak?
  fatherIsAlive                         Boolean?
  motherIsAlive                         Boolean?
  fatherProfession                      String?
  motherProfession                      String?
  brotherCount                          Int?
  sisterCount                           Int?
  unclesOccupations                     String?
  residenceDescription                  String?
  familyEconomicClass                   FamilyEconomicClass?
  familyRelatives                       Json                         @default("[]")
  prayerRegularity                      PrayerRegularity?
  missedFardPrayersNotes                String?
  aqeedahNotes                          String?
  sunnahBeardStatus                     SunnahBeardStatus?
  beardDetails                          String?
  usualOutdoorClothing                  String?
  quranRecitationLevel                  QuranRecitationLevel?
  favoriteIslamicBooks                  String?
  favoriteScholars                      String?
  clothingAboveAnkles                   ClothingAboveAnkles?
  mahramCompliance                      MahramCompliance?
  entertainmentHabits                   String?
  dawahInvolvement                      String?
  quranHifzNotes                        String?
  incomeFullyHalal                      Boolean?
  hijabPurdah                           HijabPurdah?
  photoVisibility                       PhotoVisibility              @default(MEMBERS_ONLY)
  isDiscoverable                        Boolean                      @default(true)
  isVisibilityPrivate                   Boolean                      @default(false)
  hasConfirmedMarriage                  Boolean                      @default(false)
  showMarriagePartnerOnPublicBiodata    Boolean                      @default(false)
  checkInTimeZone                       String?
  showContactOnlyToAccepted             Boolean                      @default(true)
  hideFromContacts                      Boolean                      @default(false)
  guardianManaged                       Boolean                      @default(false)
  discoveryReligionMode                 BiodataDiscoveryReligionMode @default(SAME_AS_MINE)
  discoveryReligionAllowList            Religion[]                   @default([])
  guardianName                          String?
  guardianRelationship                  String?
  guardianMobile                        String?
  candidateMobile                       String?
  guardianTelegram                      String?
  guardianWhatsApp                      String?
  candidateTelegram                     String?
  candidateWhatsApp                     String?
  marriagePledgeInformationTrue         Boolean                      @default(false)
  marriagePledgeGuardianConsent         Boolean                      @default(false)
  marriagePledgeFalseInfoAccountability Boolean                      @default(false)
  marriagePledgeMarkAfterMarriage       Boolean                      @default(false)
  marriagePledgesAcceptedAt             DateTime?
  completenessScore                     Int                          @default(0)
  createdAt                             DateTime                     @default(now())
  updatedAt                             DateTime                     @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnerPreference PartnerPreference?
  myPreference      MyPreference?
  galleryPhotos     BiodataGalleryPhoto[]

  @@index([tenantId, religion, gender, isDiscoverable])
  @@index([isVisibilityPrivate, userId])
  @@map("profiles")
}

model BiodataGalleryPhoto {
  id        String   @id @default(cuid())
  profileId String
  sortOrder Int      @default(0)
  url       String
  publicId  String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("biodata_gallery_photos")
}

model PartnerPreference {
  id                        String                     @id @default(cuid())
  profileId                 String                     @unique
  userId                    String                     @unique
  tenantId                  String
  preferredGender           Gender
  minAge                    Int                        @default(21)
  maxAge                    Int                        @default(35)
  complexions               ComplexionPreference[]
  minHeightCm               Int?
  maxHeightCm               Int?
  educationLevels           EducationPreference[]
  occupations               OccupationPreference[]
  maritalStatuses           MaritalStatus[]
  minMonthlyIncome          Decimal?                   @db.Decimal(12, 2)
  maxMonthlyIncome          Decimal?                   @db.Decimal(12, 2)
  incomeCurrency            String                     @default("USD")
  residenceType             ResidenceTypePreference?
  familyStatus              FamilyStatusPreference?
  siblingCountPreference    Int?
  siblingPositionPreference SiblingPositionPreference?
  preferredDistricts        String[]
  preferredCountries        String[]
  preferredReligions        Religion[]
  preferredDenominations    String[]
  preferredCommunities      String[]
  preferredMotherTongues    String[]
  employmentTypes           EmploymentTypePreference[]
  willingToRelocate         Boolean                    @default(false)
  openToAbroad              Boolean                    @default(false)
  requiresVerifiedProfile   Boolean                    @default(false)
  minProfileCompleteness    Int                        @default(0)
  isActive                  Boolean                    @default(true)
  customExpectations        Json                       @default("{}")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, preferredGender, minAge, maxAge])
  @@map("partner_preferences")
}

/// Self-side enum-normalized facts for match scoring: compare A.partnerPreference to B.myPreference (and vice versa).
/// Age scoring uses Profile.dateOfBirth. Match percentage is computed in the API layer, not stored on this model.
model MyPreference {
  id                 String                     @id @default(cuid())
  profileId          String                     @unique
  userId             String                     @unique
  tenantId           String
  gender             Gender
  complexion         ComplexionPreference?
  heightCm           Int?
  educationLevel     EducationPreference?
  occupation         OccupationPreference?
  maritalStatus      MaritalStatus?
  monthlyIncome      Decimal?                   @db.Decimal(12, 2)
  incomeCurrency     String                     @default("USD")
  residenceType      ResidenceTypePreference?
  familyStatus       FamilyStatusPreference?
  siblingCount       Int?
  siblingPosition    SiblingPositionPreference?
  district           String?
  country            String?
  religion           Religion?
  denomination       String?
  community          String?
  motherTongue       String?
  employmentTypes    EmploymentTypePreference[]
  willingToRelocate  Boolean                    @default(false)
  openToAbroad       Boolean                    @default(false)
  customExpectations Json                       @default("{}")
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, gender, religion])
  @@map("my_preferences")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  tenantId  String
  balance   Int      @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([tenantId])
  @@map("credit_wallets")
}

model CreditTransaction {
  id        String                @id @default(cuid())
  walletId  String
  amount    Int
  type      CreditTransactionType
  reference String?
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("credit_transactions")
}

model Proposal {
  id               String         @id @default(cuid())
  tenantId         String
  senderId         String
  receiverId       String
  status           ProposalStatus @default(PENDING)
  message          String?
  creditsSpent     Int            @default(0)
  consentGrantedAt DateTime?
  respondedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender      User         @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("ProposalReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  consentLogs ConsentLog[]

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([tenantId, status])
  @@map("proposals")
}

model ConsentLog {
  id         String      @id @default(cuid())
  userId     String
  type       ConsentType
  granted    Boolean
  proposalId String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@map("consent_logs")
}

model BiodataSectionVisibility {
  id          String                       @id @default(cuid())
  tenantId    String
  ownerUserId String
  sectionId   String
  mode        BiodataSectionVisibilityMode @default(REQUEST)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("BiodataVisibilityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, sectionId])
  @@index([tenantId, ownerUserId])
  @@map("biodata_section_visibilities")
}

model BiodataAccessRequest {
  id              String                     @id @default(cuid())
  tenantId        String
  ownerUserId     String
  requesterUserId String
  sectionId       String
  status          BiodataAccessRequestStatus @default(PENDING)
  message         String?
  expiresAt       DateTime?
  decidedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User   @relation("BiodataAccessRequestOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  requester User   @relation("BiodataAccessRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, createdAt])
  @@index([requesterUserId, status])
  @@index([tenantId, status])
  @@map("biodata_access_requests")
}

model BiodataEditorGrant {
  id           String                        @id @default(cuid())
  tenantId     String
  ownerUserId  String
  editorUserId String
  status       BiodataEditorGrantStatus      @default(PENDING)
  initiatedBy  BiodataEditorGrantInitiatedBy
  scope        BiodataEditorScope            @default(BOTH)
  message      String?
  expiresAt    DateTime?
  approvedAt   DateTime?
  revokedAt    DateTime?
  decidedAt    DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("BiodataEditorGrantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  editor User   @relation("BiodataEditorGrantEditor", fields: [editorUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, editorUserId])
  @@index([editorUserId, status])
  @@index([ownerUserId, status])
  @@index([tenantId, status])
  @@map("biodata_editor_grants")
}

enum MarriageConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  DIVORCED
  DECEASED
}

enum MarriageRecordStatus {
  DRAFT
  CONFIRMED
  DIVORCED
  DECEASED
}

enum MarriageSpouseRole {
  WIFE
  HUSBAND
}

model MarriageConfirmation {
  id                       String                     @id @default(cuid())
  tenantId                 String
  initiatorUserId          String
  partnerUserId            String?
  marriageDate             DateTime                   @db.Date
  status                   MarriageConfirmationStatus @default(PENDING)
  divorceRequestedByUserId String?
  divorceRequestedAt       DateTime?
  initiatedAt              DateTime                   @default(now())
  respondedAt              DateTime?
  confirmedAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiator          User             @relation("MarriageInitiator", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  partner            User?            @relation("MarriagePartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  divorceRequestedBy User?            @relation("MarriageDivorceRequestedBy", fields: [divorceRequestedByUserId], references: [id], onDelete: SetNull)
  marriageRecords    MarriageRecord[]

  @@unique([initiatorUserId, partnerUserId, marriageDate], map: "marriage_confirmations_initiator_partner_date_key")
  @@index([partnerUserId, status])
  @@index([initiatorUserId, status])
  @@index([tenantId, status])
  @@map("marriage_confirmations")
}

model MarriageRecord {
  id                     String               @id @default(cuid())
  tenantId               String
  userId                 String
  slotIndex              Int
  spouseRole             MarriageSpouseRole
  status                 MarriageRecordStatus @default(DRAFT)
  marriageDate           DateTime?            @db.Date
  statusEndedAt          DateTime?            @db.Date
  lockedAt               DateTime?
  spouseNameEnc          String?
  spousePhoneEnc         String?
  spouseTelegramEnc      String?
  spouseWhatsAppEnc      String?
  childrenEnc            Json?
  linkedPartnerUserId    String?
  partnerUsernameHint    String?
  marriageConfirmationId String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  marriageConfirmation MarriageConfirmation? @relation(fields: [marriageConfirmationId], references: [id], onDelete: SetNull)

  @@unique([userId, slotIndex])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("marriage_records")
}

model MarriageRecordArchive {
  id                     String               @id @default(cuid())
  tenantId               String
  userId                 String
  originalSlotIndex      Int
  spouseRole             MarriageSpouseRole
  endedStatus            MarriageRecordStatus
  marriageDate           DateTime?            @db.Date
  statusEndedAt          DateTime?            @db.Date
  lockedAt               DateTime?
  spouseNameEnc          String?
  spousePhoneEnc         String?
  spouseTelegramEnc      String?
  spouseWhatsAppEnc      String?
  childrenEnc            Json?
  linkedPartnerUserId    String?
  partnerUsernameHint    String?
  marriageConfirmationId String?
  archivedAt             DateTime             @default(now())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt])
  @@index([tenantId])
  @@map("marriage_record_archives")
}

model Community {
  id                 String                    @id @default(cuid())
  tenantId           String
  createdByUserId    String
  name               String
  slug               String
  description        String?
  coverImageUrl      String?
  coverImagePublicId String?
  allowedReligions   Religion[]                @default([])
  allowedCountries   String[]                  @default([])
  minAge             Int?
  maxAge             Int?
  privacy            CommunityPrivacy          @default(PUBLIC)
  postApprovalMode   CommunityPostApprovalMode @default(AUTO_APPROVE)
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("CommunityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members      CommunityMember[]
  joinRequests CommunityJoinRequest[]
  posts        CommunityPost[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@map("communities")
}

model CommunityMember {
  id              String                @id @default(cuid())
  communityId     String
  userId          String
  tenantId        String
  role            CommunityMemberRole   @default(MEMBER)
  status          CommunityMemberStatus @default(ACTIVE)
  isTrustedPoster Boolean               @default(false)
  joinedAt        DateTime              @default(now())
  blockedAt       DateTime?
  removedAt       DateTime?
  removedByUserId String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  removedBy User?     @relation("CommunityMemberRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId, status, role])
  @@index([userId, status])
  @@map("community_members")
}

model CommunityJoinRequest {
  id              String                     @id @default(cuid())
  communityId     String
  userId          String
  tenantId        String
  message         String?
  status          CommunityJoinRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("CommunityJoinRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@index([userId, status])
  @@map("community_join_requests")
}

model CommunityPost {
  id                 String              @id @default(cuid())
  communityId        String
  authorUserId       String
  tenantId           String
  bodyText           String?
  status             CommunityPostStatus @default(PENDING)
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  scheduleJobId      String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectReason       String?
  referencedUserId   String?
  shareToken         String              @unique @default(cuid())
  deletedAt          DateTime?
  deletedByUserId    String?
  reactionsCount     Int                 @default(0)
  commentsCount      Int                 @default(0)
  sharesCount        Int                 @default(0)
  hotScore           Float               @default(0)
  hotScoreUpdatedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  community      Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author         User                 @relation("CommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reviewer       User?                @relation("CommunityPostReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  referencedUser User?                @relation("CommunityPostReferencedUser", fields: [referencedUserId], references: [id], onDelete: SetNull)
  deletedBy      User?                @relation("CommunityPostDeleter", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  images         CommunityPostImage[]
  comments       CommunityComment[]
  reactions      CommunityReaction[]  @relation("CommunityPostReactions")

  @@index([communityId, status, publishedAt])
  @@index([communityId, status, hotScore, id])
  @@index([status, scheduledPublishAt])
  @@index([authorUserId, communityId])
  @@map("community_posts")
}

model CommunityPostImage {
  id        String  @id @default(cuid())
  postId    String
  sortOrder Int     @default(0)
  url       String
  publicId  String?
  width     Int?
  height    Int?

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("community_post_images")
}

model CommunityComment {
  id                  String    @id @default(cuid())
  postId              String
  authorUserId        String
  parentCommentId     String?
  threadRootCommentId String?
  bodyText            String
  hiddenAt            DateTime?
  pinnedRank          Int?
  editedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  post          CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User                @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parent        CommunityComment?   @relation("CommunityCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       CommunityComment[]  @relation("CommunityCommentThread")
  threadRoot    CommunityComment?   @relation("CommunityCommentThreadRoot", fields: [threadRootCommentId], references: [id], onDelete: Cascade)
  threadReplies CommunityComment[]  @relation("CommunityCommentThreadRoot")
  reactions     CommunityReaction[] @relation("CommunityCommentReactions")

  @@unique([postId, pinnedRank])
  @@index([postId, createdAt])
  @@index([postId, pinnedRank])
  @@index([postId, threadRootCommentId])
  @@map("community_comments")
}

model UserNotification {
  id        String               @id @default(cuid())
  userId    String
  tenantId  String
  type      UserNotificationType
  title     String
  body      String?
  linkPath  String
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("user_notifications")
}

model UserActivityLog {
  id            String           @id @default(cuid())
  tenantId      String
  userId        String
  type          UserActivityType
  /// Legacy plaintext; new rows use payloadEnc only.
  title         String?
  body          String?
  linkPath      String?
  actorUserId   String?
  relatedUserId String?
  /// Legacy plaintext metadata; new rows store metadata inside payloadEnc.
  metadata      Json?
  payloadEnc    Json?
  searchTokens  String[]         @default([])
  occurredAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt, id])
  @@index([userId, type, occurredAt, id])
  @@index([searchTokens], type: Gin, map: "user_activity_logs_search_tokens_gin")
  @@map("user_activity_logs")
}

model AuditEvent {
  id           String           @id @default(cuid())
  tenantId     String
  type         AuditEventType
  status       AuditEventStatus @default(SUCCESS)
  actorUserId  String?
  targetUserId String?
  linkPath     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  payloadEnc   Json?
  searchTokens String[]         @default([])
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())

  @@index([tenantId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
  @@index([targetUserId, occurredAt, id])
  @@index([type, occurredAt, id])
  @@index([searchTokens], type: Gin, map: "audit_events_search_tokens_gin")
  @@map("audit_events")
}

model AuthSession {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  /// SHA-256 hex of the current refresh token (rotates on refresh).
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  payloadEnc       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tenantId, userId])
  @@map("auth_sessions")
}

model CommunityReaction {
  id        String                @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  kind      CommunityReactionKind
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    CommunityPost?    @relation("CommunityPostReactions", fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityComment? @relation("CommunityCommentReactions", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("community_reactions")
}

enum SubscriptionTier {
  SILVER
  GOLD
  PLATINUM
}

enum SubscriptionBillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionPlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionCouponDiscountType {
  PERCENT
  FIXED_CENTS
}

enum SubscriptionCheckoutIntentStatus {
  CREATED
  COMPLETED
  ABANDONED
}

model SubscriptionPlan {
  id         String                      @id @default(cuid())
  slug       String                      @unique
  tier       SubscriptionTier
  interval   SubscriptionBillingInterval
  name       String
  tagline    String?
  priceCents Int
  currency   String                      @default("USD")
  isFeatured Boolean                     @default(false)
  sortOrder  Int                         @default(0)
  features   Json                        @default("[]")
  status     SubscriptionPlanStatus      @default(ACTIVE)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  checkoutIntents SubscriptionCheckoutIntent[]

  @@index([status, interval, sortOrder])
  @@map("subscription_plans")
}

model SubscriptionCoupon {
  id                   String                         @id @default(cuid())
  code                 String                         @unique
  description          String?
  discountType         SubscriptionCouponDiscountType
  discountValue        Int
  validFrom            DateTime?
  validUntil           DateTime?
  maxRedemptions       Int?
  redemptionCount      Int                            @default(0)
  applicableTier       SubscriptionTier?
  applicableInterval   SubscriptionBillingInterval?
  isActive             Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@map("subscription_coupons")
}

model SubscriptionCheckoutIntent {
  id         String                           @id @default(cuid())
  userId     String
  planId     String
  couponCode String?
  status     SubscriptionCheckoutIntentStatus @default(CREATED)
  metadata   Json                             @default("{}")
  createdAt  DateTime                         @default(now())
  updatedAt  DateTime                         @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([planId])
  @@map("subscription_checkout_intents")
}

model SystemPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  markdown  String   @db.Text
  sortOrder Int
  sidebar   Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@map("system_pages")
}
